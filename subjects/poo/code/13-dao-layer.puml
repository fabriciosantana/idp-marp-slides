@startuml
title Organizacao simples com DAO

skinparam shadowing false
skinparam backgroundColor transparent
skinparam defaultFontSize 18
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #154E75
  FontColor #111827
  FontSize 18
}
skinparam database {
  BackgroundColor #FFF7D6
  BorderColor #C8A23A
}
skinparam ArrowColor #0F4C75
skinparam ArrowFontColor #111827

package "Aplicacao Java" {
  class Main
  class AlunoService {
    +matricular(aluno)
    +listarAprovados()
  }
  class AlunoDao {
    +salvar(aluno)
    +buscarPorId(id)
    +listar()
  }
  class Aluno {
    -id: int
    -nome: String
    -nota: BigDecimal
  }
}

database "Banco relacional" as db {
  frame "tabela aluno" {
  }
}

Main --> AlunoService
AlunoService --> AlunoDao
AlunoDao --> Aluno
AlunoDao ..> "java.sql.Connection"
AlunoDao ..> db : SQL/JDBC

@enduml
