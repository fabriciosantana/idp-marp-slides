@startuml
title JDBC API - principais interfaces

skinparam shadowing false
skinparam backgroundColor transparent
skinparam classAttributeIconSize 0
skinparam defaultFontSize 18
skinparam linetype ortho
skinparam nodesep 48
skinparam ranksep 40
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #154E75
  FontColor #111827
  FontSize 18
}
skinparam interface {
  BackgroundColor #EAF4FA
  BorderColor #154E75
}
skinparam ArrowColor #0F4C75
skinparam ArrowFontColor #111827

class DriverManager {
  +getConnection(url, user, password)
}

interface DataSource {
  +getConnection()
}

interface Connection {
  +createStatement()
  +prepareStatement(sql)
  +prepareCall(sql)
  +setAutoCommit(boolean)
  +commit()
  +rollback()
}

interface Statement {
  +executeQuery(sql)
  +executeUpdate(sql)
  +execute(sql)
  +setFetchSize(rows)
}

interface PreparedStatement {
  +setString(index, value)
  +setInt(index, value)
  +setObject(index, value)
  +executeQuery()
  +executeUpdate()
}

interface CallableStatement {
  +registerOutParameter(index, type)
  +execute()
}

interface ResultSet {
  +next()
  +getString(column)
  +getInt(column)
  +getObject(column)
  +close()
}

class SQLException {
  +getSQLState()
  +getErrorCode()
  +getNextException()
}

' Layout em 4 colunas logicas:
' 1) DriverManager / DataSource
' 2) Connection
' 3) Statement / PreparedStatement / CallableStatement
' 4) ResultSet / SQLException

' Pilhas verticais das colunas 1, 3 e 4.
DriverManager -down[hidden]- DataSource
Statement -down[hidden]- PreparedStatement
PreparedStatement -down[hidden]- CallableStatement
ResultSet -down[hidden]- SQLException

' Cadeia horizontal que define as 4 colunas.
DriverManager -right[hidden]- Connection
Connection -right[hidden]- Statement
Statement -right[hidden]- ResultSet

DriverManager -[norank,dashed]-> Connection : cria
DataSource -[norank,dashed]-> Connection : fornece
Connection -[norank,dashed]-> Statement : cria
Connection -[norank,dashed]-> PreparedStatement : prepara
Connection -[norank,dashed]-> CallableStatement : prepara
Statement <|-- PreparedStatement
PreparedStatement <|-- CallableStatement
Statement -[norank,dashed]-> ResultSet : retorna
PreparedStatement -[norank,dashed]-> ResultSet : retorna

@enduml
