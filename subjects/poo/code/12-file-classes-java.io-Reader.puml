@startuml
title java.io - Reader

skinparam classAttributeIconSize 0
skinparam linetype ortho

interface Readable
interface Closeable

abstract class Reader {
  +read(): int
  +read(char[]): int
  +skip(long): long
  +close(): void
}

class BufferedReader
class CharArrayReader
class FilterReader
class InputStreamReader
class FileReader
class PipedReader
class StringReader
class PushbackReader
class LineNumberReader

Readable <|.. Reader
Closeable <|.. Reader

Reader <|-- BufferedReader
Reader <|-- CharArrayReader
Reader <|-- FilterReader
Reader <|-- InputStreamReader
Reader <|-- PipedReader
Reader <|-- StringReader

InputStreamReader <|-- FileReader
FilterReader <|-- PushbackReader
BufferedReader <|-- LineNumberReader

BufferedReader ..> Reader : envolve
InputStreamReader ..> InputStream : bytes para caracteres
FileReader ..> FileInputStream : atalho para arquivo

@enduml
