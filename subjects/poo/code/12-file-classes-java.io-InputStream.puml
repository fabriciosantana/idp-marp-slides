@startuml
title java.io - InputStream

skinparam classAttributeIconSize 0
skinparam linetype ortho

interface Closeable

abstract class InputStream {
  +read(): int
  +read(byte[]): int
  +skip(long): long
  +close(): void
}

class ByteArrayInputStream
class FileInputStream
class FilterInputStream
class BufferedInputStream
class DataInputStream
class ObjectInputStream
class PipedInputStream
class SequenceInputStream

Closeable <|.. InputStream

InputStream <|-- ByteArrayInputStream
InputStream <|-- FileInputStream
InputStream <|-- FilterInputStream
InputStream <|-- ObjectInputStream
InputStream <|-- PipedInputStream
InputStream <|-- SequenceInputStream

FilterInputStream <|-- BufferedInputStream
FilterInputStream <|-- DataInputStream

BufferedInputStream ..> InputStream : envolve
DataInputStream ..> InputStream : le tipos primitivos
ObjectInputStream ..> InputStream : desserializa objetos
SequenceInputStream ..> InputStream : concatena streams

@enduml
