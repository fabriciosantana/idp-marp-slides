@startuml
title java.io - Writer

skinparam classAttributeIconSize 0
skinparam linetype ortho

interface Appendable
interface Closeable
interface Flushable

abstract class Writer {
  +write(String): void
  +append(CharSequence): Writer
  +flush(): void
  +close(): void
}

class BufferedWriter
class CharArrayWriter
class FilterWriter
class OutputStreamWriter
class FileWriter
class PipedWriter
class PrintWriter
class StringWriter

Appendable <|.. Writer
Closeable <|.. Writer
Flushable <|.. Writer

Writer <|-- BufferedWriter
Writer <|-- CharArrayWriter
Writer <|-- FilterWriter
Writer <|-- OutputStreamWriter
Writer <|-- PipedWriter
Writer <|-- PrintWriter
Writer <|-- StringWriter

OutputStreamWriter <|-- FileWriter

BufferedWriter ..> Writer : envolve
PrintWriter ..> Writer : escrita formatada
OutputStreamWriter ..> OutputStream : caracteres para bytes
FileWriter ..> FileOutputStream : atalho para arquivo

@enduml
