@startuml
title java.sql.ParameterMetaData

skinparam shadowing false
skinparam backgroundColor transparent
skinparam classAttributeIconSize 0
skinparam defaultFontSize 18
skinparam linetype ortho
skinparam interface {
  BackgroundColor #EAF4FA
  BorderColor #154E75
  FontColor #111827
  FontSize 18
}
skinparam ArrowColor #0F4C75
skinparam ArrowFontColor #111827

interface PreparedStatement {
  +getParameterMetaData()
}

interface ParameterMetaData {
  +getParameterCount()
  +getParameterType(index)
  +getParameterTypeName(index)
  +isNullable(index)
  +getParameterMode(index)
}

PreparedStatement --> ParameterMetaData : getParameterMetaData()

@enduml
