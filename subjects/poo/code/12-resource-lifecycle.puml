@startuml
skinparam shadowing false
skinparam backgroundColor transparent
skinparam defaultFontSize 18
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #154E75
  FontColor #111827
  FontSize 18
  RoundCorner 10
  DiamondBackgroundColor #EAF4FA
  DiamondBorderColor #154E75
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #C8A23A
  FontSize 16
}
skinparam ArrowColor #0F4C75
skinparam ArrowFontSize 16
skinparam ArrowFontColor #111827

start

:Declarar recurso no try (...);
:Abrir stream / reader / writer;
:Executar o bloco try;

if (Operacao de I/O?) then (read/write)
  :Ler ou escrever dados;
endif

if (Ocorreu IOException?) then (sim)
  :Tratar erro no catch;
else (nao)
  :Seguir fluxo normal;
endif

:Fechar recurso automaticamente;

note right
  O try-with-resources chama close()
  automaticamente, mesmo quando
  ocorre uma excecao no bloco try.
end note

stop

@enduml
